---
import "@/styles/global.css";
import monaSans from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url";
import { DATA } from "@/data/resume";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
}

// The summary is markdown with in-page links; meta tags want its first paragraph as plain text.
const plainSummary = DATA.summary
  .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
  .trim()
  .split(/\n\s*\n/)[0];

const {
  title = `${DATA.name} | ${DATA.description}`,
  description = plainSummary,
  image = `${DATA.url}/me.webp`,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, DATA.url).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0c0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={monaSans} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={DATA.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body class="relative overflow-x-clip">
    <div class="ghost-grid" aria-hidden="true">
      <div class="wrap h-full">
        <div class="grid-page">
          {Array.from({ length: 12 }, (_, i) => <span style={`--i:${i}`} />)}
        </div>
      </div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
